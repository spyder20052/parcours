{
  "name": "parcours",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "db:up": "docker compose up -d",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "storage:init": "node --env-file=.env.local --import tsx scripts/setup-storage.mts",
    "setup": "npm run db:up && npm run db:migrate && npm run storage:init",
    "import": "node --conditions=react-server --env-file=.env.local --import tsx scripts/import.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1163.0",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "next": "16.4.4",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.37.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tsx": "4.21.0",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}

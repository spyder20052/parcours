# Copie ce fichier en .env.local pour le développement. Ne versionne jamais .env.local.

# URL publique de l'application (sans barre finale)
APP_URL=http://localhost:3000

# Base PostgreSQL. En production : chaîne de connexion Neon « pooled » du rôle propriétaire.
DATABASE_URL=postgres://parcours_owner:parcours_local@localhost:5433/parcours

# Secret des sessions : au moins 32 caractères aléatoires (openssl rand -base64 32)
BETTER_AUTH_SECRET=remplace-moi-par-une-valeur-aleatoire-de-32-caracteres

# Clé de chiffrement des clés IA : 32 octets en base64 (openssl rand -base64 32)
APP_ENCRYPTION_KEY=

# Premier administrateur : seul e-mail autorisé à se connecter sans invitation
ADMIN_EMAIL=toi@exemple.com

# Connexion Google (facultatif en local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envoi des e-mails. Sans clé, les liens de connexion s'affichent dans le terminal.
RESEND_API_KEY=
MAIL_FROM="Parcours <connexion@exemple.com>"

# Stockage des documents. En local : SeaweedFS du docker compose. En production : Cloudflare R2.
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_BUCKET=parcours-documents
S3_ACCESS_KEY_ID=parcours
S3_SECRET_ACCESS_KEY=parcours_local_secret
S3_FORCE_PATH_STYLE=true

# Outlook (facultatif) : application Microsoft Entra ID, voir docs/DEPLOIEMENT.md, étape 5.
# Sans ces deux valeurs, l'envoi par Outlook n'apparaît pas.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# « common » accepte les comptes professionnels, scolaires et personnels. Mets l'identifiant de ton établissement pour le restreindre.
MS_TENANT=common
# Secret de la tâche quotidienne qui prolonge les abonnements Outlook (openssl rand -base64 32). Vercel l'envoie tout seul.
CRON_SECRET=
